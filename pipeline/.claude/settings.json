{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m src.run:*)",
      "Bash(nbstripout:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c pipeline/:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(earthengine:*)",
      "Bash(pip install:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(~/.config/earthengine/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
